<!-- FEATURE 1: Search by style -->
<section class="qp-feature">
  <div class="qp-feature-visual" style="background:#f8f0ec;">
    <div class="qp-feature-mock">
      <div class="qp-feature-mock-bar">
        <i class="fas fa-search"></i>
        <span>Search by style, location…</span>
        <span style="margin-left:auto;font-weight:700;color:#42deff;">Filter</span>
      </div>
      <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.5rem;">
        <span style="background:var(--qp-coral);color:white;padding:0.25rem 0.8rem;border-radius:10px;font-size:0.75rem;font-weight:600;font-family:var(--qp-font-secondary);">Wedding</span>
        <span style="background:white;color:#555;padding:0.25rem 0.8rem;border-radius:10px;font-size:0.75rem;font-weight:600;font-family:var(--qp-font-secondary);border:1px solid #6c757d;">Portrait</span>
        <span style="background:white;color:#555;padding:0.25rem 0.8rem;border-radius:10px;font-size:0.75rem;font-weight:600;font-family:var(--qp-font-secondary);border:1px solid #6c757d;">Event</span>
        <span style="background:white;color:#555;padding:0.25rem 0.8rem;border-radius:10px;font-size:0.75rem;font-weight:600;font-family:var(--qp-font-secondary);border:1px solid #6c757d;">Product</span>
      </div>
      <div class="qp-mock-grid" style="flex:1;">
        <img src="https://images.unsplash.com/photo-1519741497674-611481863552?w=200&q=80" alt="">
        <img src="https://images.unsplash.com/photo-1775664352285-321b99a86ab8?q=80&w=200&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="">
        <img src="https://images.unsplash.com/photo-1554048612-b6a482bc67e5?w=200&q=80" alt="">
      <img src="https://plus.unsplash.com/premium_photo-1671244010956-c2c7cd3ed2ee?q=80&w=200&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" style="height:200px;" alt="">
        <img src="https://images.unsplash.com/photo-1775498590769-7cdd402a7737?q=80&w=200&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="">
