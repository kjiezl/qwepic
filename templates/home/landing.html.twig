{% extends 'base.html.twig' %}

{% block title %}QwePic - Find ideas for your next shoot{% endblock %}

{% block sidebar %}{% endblock %}

{% block main_classes %}min-h-screen{% endblock %}

{% block body %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap');

  :root {
    --qp-red: #42deff;
    --qp-red-hover: #60a5fa;
    --qp-coral: #FF6B6B;
    --qp-coral-soft: #fff0f0;
    --qp-space-cadet: #1d1e35;
    --qp-dark: #1d1e35;
    --qp-slate-gray: #6c757d;
    --qp-gray: #767676;
    --qp-light-bg: #f5f5f0;
    --qp-white: #ffffff;
    --qp-border: #efefef;
    --qp-font-main: 'Poppins', sans-serif;
    --qp-font-secondary: 'Inter', sans-serif;
  }

  * { box-sizing: border-box; }

  body { font-family: var(--qp-font-main); color: var(--qp-dark); }

  .qp-sans { font-family: var(--qp-font-secondary); }

  /* Nav */
  .qp-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--qp-border);
    padding: 0 1.5rem;
    height: 60px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .qp-nav-logo { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; }
  .qp-nav-logo-img { height: 28px; width: auto; display: block; }
  .qp-nav-links { display: flex; align-items: center; gap: 1.5rem; }
  .qp-nav-link { color: #555; text-decoration: none; font-family: var(--qp-font-secondary); font-size: 0.95rem; font-weight: 600; }
  .qp-nav-link:hover { color: var(--qp-coral); }
  .qp-nav-link.active { color: var(--qp-coral); }
  .qp-btn-outline {
    padding: 0.55rem 1.1rem; border: 2px solid var(--qp-coral); border-radius: 10px;
    color: var(--qp-coral); font-weight: 700; font-size: 0.9rem;
    font-family: var(--qp-font-secondary); text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .qp-btn-outline:hover { background: var(--qp-coral); color: white; }
  .qp-btn-red {
    padding: 0.55rem 1.2rem; border: 2px solid var(--qp-red); background: var(--qp-red); border-radius: 10px;
    color: var(--qp-space-cadet); font-weight: 700; font-size: 0.9rem;
    font-family: var(--qp-font-secondary); text-decoration: none;
    transition: background 0.15s;
  }
  .qp-btn-red:hover { background: var(--qp-red-hover); border: 2px solid var(--qp-red-hover); }

  /* Hero */
  .qp-hero {
    padding-top: 60px;
    min-height: 100vh;
    display: grid; grid-template-columns: 1fr 1fr;
    align-items: center;
    background: var(--qp-white);
    overflow: hidden;
    gap: 2rem;
    padding-left: 6vw; padding-right: 0;
  }
  .qp-hero-text { max-width: 680px; }
  .qp-hero-eyebrow {
    font-family: var(--qp-font-secondary); font-size: 1.1rem; font-weight: 600;
    color: var(--qp-coral); margin-bottom: 0.5rem;
  }
  .qp-hero-heading {
    font-family: var(--qp-font-main); font-weight: 800;
    font-size: clamp(2.4rem, 4vw, 3.6rem); line-height: 1.1; color: var(--qp-dark);
    margin: 0 0 0.4rem;
  }
  .qp-hero-heading-accent { color: var(--qp-coral); }
  .qp-hero-sub {
    font-family: var(--qp-font-secondary); color: var(--qp-gray);
    font-size: 1rem; margin: 0.8rem 0 1.8rem;
  }
  .qp-hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .qp-btn-red-lg {
    padding: 0.85rem 1.8rem; background: var(--qp-red); border-radius: 10px;
    color: var(--qp-space-cadet); font-weight: 700; font-size: 1rem;
    font-family: var(--qp-font-secondary); text-decoration: none;
    transition: background 0.15s; white-space: nowrap;
  }
  .qp-btn-red-lg:hover { background: var(--qp-red-hover); }
  .qp-hero-link {
    color: var(--qp-space-cadet); font-family: var(--qp-font-secondary); font-weight: 600;
    font-size: 0.95rem; text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 1px;
  }
  .qp-hero-link:hover { color: var(--qp-red); }

  /* Hero masonry */
  .qp-hero-visual {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 10px; padding: 80px 6rem 80px 1rem;
    align-items: start;
  }
  .qp-hero-col { display: flex; flex-direction: column; gap: 10px; }
  .qp-hero-col:nth-child(2) { margin-top: 40px; }
  .qp-hero-col:nth-child(3) { margin-top: 20px; }
  .qp-hero-img {
    width: 100%; border-radius: 10px; object-fit: cover;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
  }
  .qp-hero-badge {
    background: white; border-radius: 10px; padding: 0.6rem 0.9rem;
    display: inline-flex; align-items: center; gap: 0.5rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.1);
    font-family: var(--qp-font-secondary); font-size: 0.8rem; font-weight: 700;
    color: var(--qp-dark); align-self: flex-start;
  }
  .qp-hero-badge-dot { width: 10px; height: 10px; border-radius: 50%; }

  /* Tagline section */
  .qp-tagline-section {
    background: var(--qp-light-bg);
    padding: 5rem 5rem 3rem;
    text-align: center;
  }
  .qp-tagline-heading {
    font-family: var(--qp-font-main); font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.6rem); color: var(--qp-dark); margin-bottom: 0.8rem;
  }
  .qp-tagline-sub {
    color: var(--qp-gray); font-family: var(--qp-font-secondary);
    font-size: 1rem; max-width: 480px; margin: 0 auto;
  }

  /* Feature sections */
  .qp-feature {
    display: grid; grid-template-columns: 1fr 1fr;
    align-items: center; gap: 4rem;
    padding: 5rem 6vw;
    background: var(--qp-white);
  }
  .qp-feature.qp-feature-alt { background: var(--qp-white); }
  .qp-feature.qp-feature-alt .qp-feature-visual { order: -1; }
  .qp-feature-visual {
    background: var(--qp-light-bg);
    border-radius: 10px;
    overflow: hidden; aspect-ratio: 4/3;
    display: flex; align-items: center; justify-content: center;
    position: relative; box-shadow: 0 2px 24px rgba(0,0,0,0.06);
  }
  .qp-feature-visual img { width: 100%; height: 100%; object-fit: cover; }
  .qp-feature-mock {
    width: 100%; height: 100%; padding: 1.5rem;
    display: flex; flex-direction: column; gap: 0.6rem;
  }
  .qp-feature-mock-bar {
    background: white; border-radius: 10px; padding: 0.5rem 0.8rem;
    display: flex; align-items: center; gap: 0.5rem;
    box-shadow: 0 1px 6px rgba(0,0,0,0.08);
    font-family: var(--qp-font-secondary); font-size: 0.78rem; color: var(--qp-gray);
  }
  .qp-feature-mock-bar i { color: var(--qp-coral); }
  .qp-mock-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; flex: 1; }
  .qp-mock-grid img { width: 100%; border-radius: 10px; object-fit: cover; aspect-ratio: 1; }
  .qp-feature-text {}
  .qp-feature-label {
    font-family: var(--qp-font-secondary); font-weight: 700; font-size: 0.8rem;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--qp-gray); margin-bottom: 0.6rem;
  }
  .qp-feature-heading {
    font-family: var(--qp-font-main); font-weight: 800;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem); color: var(--qp-dark);
    line-height: 1.2; margin-bottom: 0.8rem;
  }
  .qp-feature-desc {
    font-family: var(--qp-font-secondary); color: var(--qp-gray);
    font-size: 1rem; line-height: 1.6; margin-bottom: 1.5rem;
  }
  .qp-btn-red-sm {
    display: inline-block; padding: 0.65rem 1.4rem; background: var(--qp-red);
    border-radius: 10px; color: var(--qp-space-cadet); font-weight: 700; font-size: 0.9rem;
    font-family: var(--qp-font-secondary); text-decoration: none;
    transition: background 0.15s;
  }
  .qp-btn-red-sm:hover { background: var(--qp-red-hover); }

  /* Board card mock */
  .qp-board-card {
    position: absolute; bottom: 1rem; right: 1rem; left: 1rem;
    background: white; border-radius: 10px; padding: 0.8rem 1rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    font-family: var(--qp-font-secondary);
  }
  .qp-board-card-title { font-weight: 700; font-size: 0.95rem; color: var(--qp-dark); }
  .qp-board-card-sub { font-size: 0.78rem; color: var(--qp-gray); }
  .qp-board-card-avatars { display: flex; gap: -4px; margin-top: 0.5rem; }
  .qp-board-card-avatar {
    width: 28px; height: 28px; border-radius: 50%; border: 2px solid white;
    background: #ddd; margin-right: -6px;
    background-size: cover; background-position: center;
  }

  /* CTA / Signup section */
  .qp-signup-section {
    position: relative; overflow: hidden;
    min-height: 560px; display: flex; align-items: center;
    background: var(--qp-light-bg);
  }
  .qp-signup-bg {
    position: absolute; inset: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px;
    opacity: 0.45; overflow: hidden;
  }
  .qp-signup-bg-col { display: flex; flex-direction: column; gap: 6px; }
  .qp-signup-bg-col:nth-child(even) { margin-top: -30px; }
  .qp-signup-bg img { width: 100%; object-fit: cover; border-radius: 10px; }
  .qp-signup-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.45); }
  /* CTA inner layout */
.qp-signup-inner,
.qp-cta-inner {
  position: relative; z-index: 2;
  width: 100%; max-width: 760px; margin: 0 auto;
  padding: 6rem 6vw;
  text-align: center;
}
.qp-cta-eyebrow {
  font-family: var(--qp-font-secondary); font-weight: 700; font-size: 0.85rem;
  text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--qp-red); margin-bottom: 1rem;
}
.qp-cta-headline {
  font-family: var(--qp-font-main); font-weight: 800;
  font-size: clamp(2rem, 4.5vw, 3.4rem); color: white;
  line-height: 1.15; margin-bottom: 1.2rem;
}
.qp-cta-sub {
  font-family: var(--qp-font-secondary); color: rgba(255,255,255,0.75);
  font-size: 1.05rem; line-height: 1.65;
  max-width: 520px; margin: 0 auto 2.2rem;
}
.qp-cta-actions {
  display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;
}
.qp-cta-btn-primary {
  padding: 0.9rem 2rem; background: var(--qp-red); border-radius: 10px;
  color: var(--qp-space-cadet); font-weight: 700; font-size: 1rem;
  font-family: var(--qp-font-secondary); text-decoration: none;
  transition: background 0.15s;
}
.qp-cta-btn-primary:hover { background: var(--qp-red-hover); }
.qp-cta-btn-ghost {
  padding: 0.9rem 2rem; border: 2px solid rgba(255,255,255,0.5); border-radius: 10px;
  color: white; font-weight: 700; font-size: 1rem;
  font-family: var(--qp-font-secondary); text-decoration: none;
  transition: border-color 0.15s, background 0.15s;
}
.qp-cta-btn-ghost:hover { border-color: white; background: rgba(255,255,255,0.08); }

  /* Footer */
  .qp-footer { background: var(--qp-dark); color: white; padding: 3rem 6vw 2rem; }
  .qp-footer-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem; padding-bottom: 2.5rem; border-bottom: 1px solid #333;
  }
  .qp-footer-logo {
    text-decoration: none; display: inline-flex; align-items: center; margin-bottom: 0.8rem;
  }
  .qp-footer-logo-img { height: 28px; width: auto; display: block; filter: brightness(0) invert(1); }
  .qp-footer-desc { color: #888; font-family: var(--qp-font-secondary); font-size: 0.9rem; line-height: 1.6; }
  .qp-footer-col-title { font-family: var(--qp-font-secondary); font-weight: 700; font-size: 0.9rem; color: white; margin-bottom: 0.8rem; }
  .qp-footer-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .qp-footer-links a { color: #888; font-family: var(--qp-font-secondary); font-size: 0.9rem; text-decoration: none; }
  .qp-footer-links a:hover { color: white; }
  .qp-footer-bottom { padding-top: 1.5rem; font-family: var(--qp-font-secondary); font-size: 0.82rem; color: #555; text-align: center; }

  /* Stats bar */
  .qp-stats { background: var(--qp-light-bg); padding: 1.5rem 6vw 2.5rem; display: flex; justify-content: center; gap: 4rem; flex-wrap: wrap; }
  .qp-stat { text-align: center; }
  .qp-stat-num { font-family: var(--qp-font-main); font-weight: 800; font-size: 2rem; color: var(--qp-coral); }
  .qp-stat-label { font-family: var(--qp-font-secondary); font-size: 0.85rem; color: var(--qp-gray); margin-top: 0.2rem; }

  /* Responsive */
  @media (max-width: 768px) {
    .qp-hero { grid-template-columns: 1fr; padding: 80px 1.5rem 2rem; min-height: auto; }
    .qp-hero-visual { display: none; }
    .qp-feature { grid-template-columns: 1fr; gap: 2rem; padding: 3rem 1.5rem; }
    .qp-feature.qp-feature-alt .qp-feature-visual { order: unset; }
    .qp-footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .qp-signup-inner { flex-direction: column; align-items: center; text-align: center; }
    .qp-nav-links { display: none; }
    .qp-stats { gap: 2rem; }
  }

  @media (max-width: 480px) {
    .qp-nav { padding: 0 1rem; }
    .qp-btn-outline, .qp-btn-red { padding: 0.5rem 0.95rem; }

    .qp-hero { padding: 76px 1rem 1.5rem; }
    .qp-hero-text { max-width: 100%; }
    .qp-hero-actions { flex-direction: column; align-items: stretch; }
    .qp-btn-red-lg { width: 100%; text-align: center; }
    .qp-hero-link { text-align: center; border-bottom: none; padding-bottom: 0; }

    .qp-tagline-section { padding: 3rem 1rem 2rem; }
    .qp-stats { padding: 1.25rem 1rem 2rem; gap: 1.5rem; }
    .qp-stat-num { font-size: 1.6rem; }

    .qp-feature { padding: 2.5rem 1rem; }

    .qp-signup-section { min-height: auto; }
    .qp-signup-inner { padding: 3rem 1rem; }
    .qp-signup-bg { grid-template-columns: repeat(2, 1fr); opacity: 0.35; }

    .qp-footer { padding: 2.5rem 1rem 1.75rem; }
    .qp-footer-grid { grid-template-columns: 1fr; }
  }
</style>

