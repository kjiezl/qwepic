{% extends 'base.html.twig' %}

{% block title %}About Us - QwePic{% endblock %}

{% block sidebar %}{% endblock %}

{% block main_classes %}min-h-screen{% endblock %}

{% block body %}
<!-- Navigation -->
<nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <a href="{{ path('app_home') }}" class="flex items-center gap-2">
                <img src="{{ asset('images/q-logo.svg') }}" alt="QwePic" class="w-8 h-8">
                <span class="font-heading font-bold text-xl text-space-cadet">QwePic</span>
            </a>
            
            <div class="hidden md:flex items-center gap-8">
                <a href="{{ path('app_photographer_index') }}" class="text-slate-gray hover:text-space-cadet transition-colors font-medium">Photographers</a>
                <a href="{{ path('app_about') }}" class="text-space-cadet font-semibold">About</a>
                <a href="{{ path('app_contact') }}" class="text-slate-gray hover:text-space-cadet transition-colors font-medium">Contact</a>
            </div>
            
            <div class="flex items-center gap-3">
                <a href="{{ path('app_login') }}" class="hidden sm:inline-flex px-4 py-2 text-space-cadet font-medium hover:text-vivid-sky-blue transition-colors">
                    Login
                </a>
                <a href="{{ path('app_register') }}" class="px-5 py-2 bg-vivid-sky-blue text-space-cadet font-semibold rounded-full hover:bg-blue-400 transition-all hover:shadow-lg">
                    Get Started
                </a>
            </div>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section class="pt-32 pb-20 bg-gradient-to-br from-space-cadet via-gray-900 to-space-cadet relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-1/3 left-1/4 w-80 h-80 bg-vivid-sky-blue/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-1/3 right-1/4 w-64 h-64 bg-accent-coral/20 rounded-full blur-3xl"></div>
    </div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-vivid-sky-blue text-sm font-medium mb-6">
            <i class="fas fa-heart"></i>
            Our Story
        </span>
        <h1 class="font-heading font-bold text-4xl sm:text-5xl lg:text-6xl text-white mb-6">
            Connecting Moments<br>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-vivid-sky-blue to-cyan-300">with Memories</span>
        </h1>
        <p class="text-lg sm:text-xl text-gray-300 max-w-2xl mx-auto">
            We believe every moment deserves to be captured beautifully. QwePic bridges the gap between talented photographers and people seeking to preserve their precious memories.
        </p>
    </div>
</section>

<!-- Our Mission -->
<section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
            <div class="relative">
                <div class="absolute -inset-4 bg-gradient-to-r from-vivid-sky-blue/30 to-accent-coral/30 rounded-3xl blur-2xl opacity-50"></div>
                <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800&q=80" alt="Team collaboration" class="relative rounded-2xl shadow-2xl w-full aspect-[4/3] object-cover">
            </div>
            
            <div>
                <span class="text-vivid-sky-blue font-semibold text-sm uppercase tracking-wider">Our Mission</span>
                <h2 class="font-heading font-bold text-3xl sm:text-4xl text-space-cadet mt-3 mb-6">
                    Democratizing Professional Photography
                </h2>
                <p class="text-slate-gray text-lg mb-6 leading-relaxed">
                    Founded in 2024, QwePic was born from a simple observation: finding the right photographer shouldn't be complicated. Whether it's a wedding, a corporate event, or a personal portrait session, everyone deserves access to talented professionals who can capture their vision.
                </p>
                <p class="text-slate-gray text-lg leading-relaxed">
                    We've built a platform that empowers photographers to showcase their unique styles while giving clients the tools to find their perfect match. Our mission is to make professional photography accessible, transparent, and delightful for everyone.
                </p>
                
                <div class="grid grid-cols-3 gap-6 mt-10 pt-10 border-t border-gray-200">
                    <div class="text-center">
                        <div class="text-3xl font-bold text-space-cadet">500+</div>
                        <div class="text-slate-gray text-sm mt-1">Photographers</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-space-cadet">10K+</div>
                        <div class="text-slate-gray text-sm mt-1">Happy Clients</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-space-cadet">50+</div>
                        <div class="text-slate-gray text-sm mt-1">Cities</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Our Values -->
<section class="py-20 lg:py-28 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <span class="text-accent-coral font-semibold text-sm uppercase tracking-wider">What We Stand For</span>
            <h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl text-space-cadet mt-3 mb-4">
                Our Core Values
            </h2>
            <p class="text-slate-gray text-lg max-w-2xl mx-auto">
                These principles guide everything we do at QwePic
            </p>
        </div>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-shadow">
                <div class="w-14 h-14 bg-gradient-to-br from-vivid-sky-blue to-cyan-400 rounded-xl flex items-center justify-center mb-6">
                    <i class="fas fa-gem text-2xl text-white"></i>
                </div>
                <h3 class="font-heading font-bold text-xl text-space-cadet mb-3">Quality First</h3>
                <p class="text-slate-gray leading-relaxed">
                    We carefully vet every photographer to ensure our clients receive exceptional service and stunning results.
                </p>
            </div>
            
            <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-shadow">
                <div class="w-14 h-14 bg-gradient-to-br from-accent-coral to-pink-400 rounded-xl flex items-center justify-center mb-6">
                    <i class="fas fa-handshake text-2xl text-white"></i>
                </div>
                <h3 class="font-heading font-bold text-xl text-space-cadet mb-3">Trust & Transparency</h3>
                <p class="text-slate-gray leading-relaxed">
                    Clear pricing, honest reviews, and open communication form the foundation of every interaction.
                </p>
            </div>
            
            <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-shadow">
                <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-indigo-500 rounded-xl flex items-center justify-center mb-6">
                    <i class="fas fa-users text-2xl text-white"></i>
                </div>
                <h3 class="font-heading font-bold text-xl text-space-cadet mb-3">Community</h3>
                <p class="text-slate-gray leading-relaxed">
                    We foster a supportive community where photographers grow and clients find lasting connections.
                </p>
            </div>
            
            <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-shadow">
                <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-emerald-500 rounded-xl flex items-center justify-center mb-6">
                    <i class="fas fa-lightbulb text-2xl text-white"></i>
                </div>
                <h3 class="font-heading font-bold text-xl text-space-cadet mb-3">Innovation</h3>
                <p class="text-slate-gray leading-relaxed">
                    We continuously improve our platform to make booking photography services easier and more enjoyable.
                </p>
            </div>
        </div>
    </div>
</section>

