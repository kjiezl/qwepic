{% extends 'base.html.twig' %}

{% block title %}About Us - QwePic{% endblock %}

{% block sidebar %}{% endblock %}

{% block main_classes %}min-h-screen{% endblock %}

{% block body %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap');

  :root {
    --qp-red: #42deff;
    --qp-red-hover: #60a5fa;
    --qp-coral: #FF6B6B;
    --qp-coral-soft: #fff0f0;
    --qp-space-cadet: #1d1e35;
    --qp-dark: #1d1e35;
    --qp-slate-gray: #6c757d;
    --qp-gray: #767676;
    --qp-light-bg: #f5f5f0;
    --qp-white: #ffffff;
    --qp-border: #efefef;
    --qp-font-main: 'Poppins', sans-serif;
    --qp-font-secondary: 'Inter', sans-serif;
  }

  * { box-sizing: border-box; }
  body { font-family: var(--qp-font-main); color: var(--qp-dark); margin: 0; }
  .qp-sans { font-family: var(--qp-font-secondary); }

  /* ── Nav (identical to landing) ── */
  .qp-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--qp-border);
    padding: 0 1.5rem;
    height: 60px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .qp-nav-logo { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; }
  .qp-nav-logo-img { height: 28px; width: auto; display: block; }
  .qp-nav-links { display: flex; align-items: center; gap: 1.5rem; }
  .qp-nav-link { color: #555; text-decoration: none; font-family: var(--qp-font-secondary); font-size: 0.95rem; font-weight: 600; }
  .qp-nav-link:hover { color: var(--qp-coral); }
  .qp-nav-link.active { color: var(--qp-coral); }
  .qp-btn-outline {
    padding: 0.55rem 1.1rem; border: 2px solid var(--qp-coral); border-radius: 10px;
    color: var(--qp-coral); font-weight: 700; font-size: 0.9rem;
    font-family: var(--qp-font-secondary); text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .qp-btn-outline:hover { background: var(--qp-coral); color: white; }
  .qp-btn-red {
    padding: 0.55rem 1.2rem; border: 2px solid var(--qp-red); background: var(--qp-red); border-radius: 10px;
    color: var(--qp-space-cadet); font-weight: 700; font-size: 0.9rem;
    font-family: var(--qp-font-secondary); text-decoration: none;
    transition: background 0.15s;
  }
  .qp-btn-red:hover { background: var(--qp-red-hover); border-color: var(--qp-red-hover); }

  /* ── Hero ── */
  .qp-about-hero {
    padding-top: 60px;
    background: var(--qp-dark);
    min-height: 420px;
    display: flex; align-items: center; justify-content: center;
    text-align: center;
    position: relative; overflow: hidden;
  }
  .qp-about-hero-bg {
    position: absolute; inset: 0;
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px;
    opacity: 0.18; overflow: hidden;
  }
  .qp-about-hero-bg-col { display: flex; flex-direction: column; gap: 6px; }
  .qp-about-hero-bg-col:nth-child(even) { margin-top: -30px; }
  .qp-about-hero-bg img { width: 100%; object-fit: cover; border-radius: 10px; flex-shrink: 0; }
  .qp-about-hero-overlay { position: absolute; inset: 0; background: rgba(29,30,53,0.72); }
  .qp-about-hero-inner { position: relative; z-index: 2; padding: 4rem 1.5rem; max-width: 700px; }
  .qp-about-hero-eyebrow {
    display: inline-block; font-family: var(--qp-font-secondary); font-weight: 700; font-size: 0.8rem;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--qp-red);
    background: rgba(66,222,255,0.12); padding: 0.3rem 0.9rem; border-radius: 10px; margin-bottom: 1rem;
  }
  .qp-about-hero-heading {
    font-family: var(--qp-font-main); font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.1; color: white; margin: 0 0 1rem;
  }
  .qp-about-hero-heading-accent { color: var(--qp-coral); }
  .qp-about-hero-sub {
    font-family: var(--qp-font-secondary); color: rgba(255,255,255,0.7);
    font-size: 1.05rem; line-height: 1.7; max-width: 520px; margin: 0 auto;
  }

  /* ── Stats bar ── */
  .qp-stats {
    background: var(--qp-light-bg); padding: 1.5rem 6vw 2.5rem;
    display: flex; justify-content: center; gap: 4rem; flex-wrap: wrap;
  }
  .qp-stat { text-align: center; }
  .qp-stat-num { font-family: var(--qp-font-main); font-weight: 800; font-size: 2rem; color: var(--qp-coral); }
  .qp-stat-label { font-family: var(--qp-font-secondary); font-size: 0.85rem; color: var(--qp-gray); margin-top: 0.2rem; }

  /* ── Mission (feature-style two-col) ── */
  .qp-mission {
    display: grid; grid-template-columns: 1fr 1fr;
    align-items: center; gap: 4rem;
    padding: 5rem 6vw;
    background: var(--qp-white);
  }
  .qp-mission-visual {
    background: var(--qp-light-bg);
    border-radius: 10px; overflow: hidden;
    aspect-ratio: 4/3;
    box-shadow: 0 2px 24px rgba(0,0,0,0.06);
  }
  .qp-mission-visual img { width: 100%; height: 100%; object-fit: cover; }
  .qp-mission-label {
    font-family: var(--qp-font-secondary); font-weight: 700; font-size: 0.8rem;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--qp-gray); margin-bottom: 0.6rem;
  }
  .qp-mission-heading {
    font-family: var(--qp-font-main); font-weight: 800;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem); color: var(--qp-dark);
    line-height: 1.2; margin-bottom: 0.8rem;
  }
  .qp-mission-body {
    font-family: var(--qp-font-secondary); color: var(--qp-gray);
    font-size: 1rem; line-height: 1.7; margin-bottom: 1rem;
  }

  /* ── Values ── */
  .qp-values-section {
    background: var(--qp-light-bg); padding: 5rem 6vw;
  }
  .qp-section-center { text-align: center; max-width: 560px; margin: 0 auto 3.5rem; }
  .qp-section-eyebrow {
    font-family: var(--qp-font-secondary); font-weight: 700; font-size: 0.8rem;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--qp-gray); margin-bottom: 0.5rem;
  }
  .qp-section-heading {
    font-family: var(--qp-font-main); font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.6rem); color: var(--qp-dark); margin-bottom: 0.8rem;
  }
  .qp-section-sub {
    color: var(--qp-gray); font-family: var(--qp-font-secondary);
    font-size: 1rem; max-width: 480px; margin: 0 auto;
  }
  .qp-values-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem; max-width: 1100px; margin: 0 auto;
  }
  .qp-value-card {
    background: white; border-radius: 10px; padding: 2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: box-shadow 0.2s;
  }
  .qp-value-card:hover { box-shadow: 0 6px 28px rgba(0,0,0,0.1); }
  .qp-value-num {
    font-family: var(--qp-font-main); font-weight: 800;
    font-size: 2rem; color: var(--qp-coral); margin-bottom: 0.5rem;
  }
  .qp-value-title {
    font-family: var(--qp-font-secondary); font-weight: 700;
    font-size: 1.05rem; color: var(--qp-dark); margin-bottom: 0.5rem;
  }
  .qp-value-desc {
    font-family: var(--qp-font-secondary); color: var(--qp-gray);
    font-size: 0.9rem; line-height: 1.6;
  }

  /* ── Team ── */
  .qp-team-section { background: var(--qp-white); padding: 5rem 6vw; }
  .qp-team-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem; max-width: 1100px; margin: 0 auto;
  }
  .qp-team-card { text-align: center; }
  .qp-team-photo-wrap {
    position: relative; overflow: hidden; border-radius: 10px;
    margin-bottom: 1rem; aspect-ratio: 3/4;
    background: var(--qp-light-bg);
  }
  .qp-team-photo-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .qp-team-card:hover .qp-team-photo-wrap img { transform: scale(1.04); }
  .qp-team-initials {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--qp-font-main); font-weight: 800; font-size: 2.5rem;
    color: white;
  }
  .qp-team-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(29,30,53,0.85) 0%, transparent 55%);
    opacity: 0; transition: opacity 0.25s;
    display: flex; align-items: flex-end; padding: 1.2rem;
  }
  .qp-team-card:hover .qp-team-overlay { opacity: 1; }
  .qp-team-socials { display: flex; gap: 0.5rem; }
  .qp-team-social {
    width: 36px; height: 36px; border-radius: 50%;
    background: rgba(255,255,255,0.2); backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    color: white; text-decoration: none; font-size: 0.85rem;
    transition: background 0.15s;
  }
  .qp-team-social:hover { background: var(--qp-red); color: var(--qp-dark); }
  .qp-team-name {
    font-family: var(--qp-font-main); font-weight: 700; font-size: 1.05rem;
    color: var(--qp-dark); margin-bottom: 0.2rem;
  }
  .qp-team-role {
    font-family: var(--qp-font-secondary); font-weight: 600; font-size: 0.82rem;
    color: var(--qp-red); margin-bottom: 0.4rem;
    /* use the cyan brand accent so it reads well on white */
    color: #0098b8;
  }
  .qp-team-bio {
    font-family: var(--qp-font-secondary); font-size: 0.85rem;
    color: var(--qp-gray); line-height: 1.55;
  }

  /* ── CTA (reuses signup section aesthetic without the form) ── */
  .qp-cta-section {
    position: relative; overflow: hidden;
    min-height: 380px; display: flex; align-items: center; justify-content: center;
    background: var(--qp-light-bg);
  }
  .qp-cta-bg {
    position: absolute; inset: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px;
    opacity: 0.35; overflow: hidden;
  }
  .qp-cta-bg-col { display: flex; flex-direction: column; gap: 6px; }
  .qp-cta-bg-col:nth-child(even) { margin-top: -30px; }
  .qp-cta-bg img { width: 100%; object-fit: cover; border-radius: 10px; }
  .qp-cta-overlay { position: absolute; inset: 0; background: rgba(29,30,53,0.62); }
  .qp-cta-inner {
    position: relative; z-index: 2; text-align: center;
    max-width: 640px; padding: 4rem 2rem;
  }
  .qp-cta-heading {
    font-family: var(--qp-font-main); font-weight: 800;
    font-size: clamp(2rem, 4vw, 3rem); color: white; line-height: 1.15; margin-bottom: 0.8rem;
  }
  .qp-cta-sub {
    font-family: var(--qp-font-secondary); color: rgba(255,255,255,0.7);
    font-size: 1rem; line-height: 1.7; margin-bottom: 2rem;
  }
  .qp-cta-actions { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
  .qp-btn-red-lg {
    padding: 0.85rem 1.8rem; background: var(--qp-red); border-radius: 10px;
    color: var(--qp-space-cadet); font-weight: 700; font-size: 1rem;
    font-family: var(--qp-font-secondary); text-decoration: none;
    transition: background 0.15s; white-space: nowrap;
  }
  .qp-btn-red-lg:hover { background: var(--qp-red-hover); }
  .qp-btn-outline-white {
    padding: 0.85rem 1.8rem; border: 2px solid rgba(255,255,255,0.4);
    border-radius: 10px; color: white; font-weight: 700; font-size: 1rem;
    font-family: var(--qp-font-secondary); text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .qp-btn-outline-white:hover { background: rgba(255,255,255,0.1); border-color: white; }

  /* ── Footer (identical to landing) ── */
  .qp-footer { background: var(--qp-dark); color: white; padding: 3rem 6vw 2rem; }
  .qp-footer-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem; padding-bottom: 2.5rem; border-bottom: 1px solid #333;
  }
  .qp-footer-logo { text-decoration: none; display: inline-flex; align-items: center; margin-bottom: 0.8rem; }
  .qp-footer-logo-img { height: 28px; width: auto; display: block; filter: brightness(0) invert(1); }
  .qp-footer-desc { color: #888; font-family: var(--qp-font-secondary); font-size: 0.9rem; line-height: 1.6; }
  .qp-footer-col-title { font-family: var(--qp-font-secondary); font-weight: 700; font-size: 0.9rem; color: white; margin-bottom: 0.8rem; }
  .qp-footer-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .qp-footer-links a { color: #888; font-family: var(--qp-font-secondary); font-size: 0.9rem; text-decoration: none; }
  .qp-footer-links a:hover { color: white; }
  .qp-footer-bottom { padding-top: 1.5rem; font-family: var(--qp-font-secondary); font-size: 0.82rem; color: #555; text-align: center; }

  /* Hamburger button */
  .qp-hamburger {
    display: none; background: none; border: none; cursor: pointer;
    width: 40px; height: 40px; align-items: center; justify-content: center;
    border-radius: 8px; transition: background 0.15s;
  }
  .qp-hamburger:hover { background: var(--qp-light-bg); }
  .qp-hamburger span {
    display: block; width: 22px; height: 2.5px; background: var(--qp-dark);
    border-radius: 2px; position: relative; transition: transform 0.3s, opacity 0.3s;
  }
  .qp-hamburger span::before, .qp-hamburger span::after {
    content: ''; position: absolute; left: 0; width: 100%; height: 2.5px;
    background: var(--qp-dark); border-radius: 2px; transition: transform 0.3s, opacity 0.3s;
  }
  .qp-hamburger span::before { top: -7px; }
  .qp-hamburger span::after { top: 7px; }
  .qp-hamburger.active span { background: transparent; }
  .qp-hamburger.active span::before { transform: translateY(7px) rotate(45deg); }
  .qp-hamburger.active span::after { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile menu overlay */
  .qp-mobile-menu {
    display: none; position: fixed; top: 60px; left: 0; right: 0; bottom: 0;
    background: rgba(255,255,255,0.98); backdrop-filter: blur(12px);
    z-index: 99; flex-direction: column; padding: 2rem 1.5rem;
    opacity: 0; transform: translateY(-10px);
    transition: opacity 0.25s, transform 0.25s;
  }
  .qp-mobile-menu.open { display: flex; opacity: 1; transform: translateY(0); }
  .qp-mobile-menu a {
    font-family: var(--qp-font-secondary); font-size: 1.1rem; font-weight: 600;
    color: var(--qp-dark); text-decoration: none; padding: 0.9rem 0;
    border-bottom: 1px solid var(--qp-border); transition: color 0.15s;
  }
  .qp-mobile-menu a:hover { color: var(--qp-coral); }
  .qp-mobile-menu a:last-child { border-bottom: none; }
  .qp-mobile-menu .qp-mobile-auth {
    display: flex; gap: 0.75rem; margin-top: 1.5rem; padding-top: 1.5rem;
    border-top: 1px solid var(--qp-border);
  }
  .qp-mobile-menu .qp-mobile-auth a {
    flex: 1; text-align: center; padding: 0.75rem 1rem;
    border-radius: 10px; font-size: 0.95rem; border-bottom: none;
  }
  .qp-mobile-menu .qp-mobile-auth .qp-mobile-login {
    border: 2px solid var(--qp-coral); color: var(--qp-coral);
  }
  .qp-mobile-menu .qp-mobile-auth .qp-mobile-signup {
    background: var(--qp-red); color: var(--qp-space-cadet); border: 2px solid var(--qp-red);
  }

  .qp-nav-auth { display: flex; align-items: center; gap: 0.6rem; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .qp-mission { grid-template-columns: 1fr; gap: 2rem; padding: 3rem 1.5rem; }
    .qp-values-section { padding: 3rem 1.5rem; }
    .qp-team-section { padding: 3rem 1.5rem; }
    .qp-stats { padding: 1.25rem 1rem 2rem; gap: 1.5rem; }
    .qp-stat-num { font-size: 1.6rem; }
    .qp-cta-bg { grid-template-columns: repeat(2, 1fr); }
    .qp-footer-grid { grid-template-columns: 1fr; gap: 2rem; }
    .qp-footer { padding: 2.5rem 1rem 1.75rem; }
    .qp-nav-links { display: none; }
    .qp-nav-auth { display: none; }
    .qp-hamburger { display: flex; }
    .qp-about-hero-bg { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 480px) {
    .qp-team-grid { grid-template-columns: repeat(2, 1fr); }
    .qp-values-grid { grid-template-columns: 1fr; }
  }
</style>

<!-- ══ NAV ══ -->
<nav class="qp-nav">
  <a href="{{ path('app_home') }}" class="qp-nav-logo">
    <img src="{{ asset('images/logo-plain.svg') }}" alt="QwePic" class="qp-nav-logo-img">
  </a>
  <div class="qp-nav-links qp-sans">
    <a href="{{ path('app_home') }}" class="qp-nav-link">Home</a>
    <a href="{{ path('app_about') }}" class="qp-nav-link active">About</a>
    <a href="{{ path('app_contact') }}" class="qp-nav-link">Contact</a>
  </div>
  <div class="qp-nav-auth">
    <a href="{{ path('app_login') }}" class="qp-btn-outline">Log in</a>
    <a href="{{ path('app_register') }}" class="qp-btn-red">Sign up</a>
  </div>
  <button class="qp-hamburger" onclick="toggleMobileNav()" aria-label="Toggle menu">
    <span></span>
  </button>
</nav>

<!-- Mobile Menu -->
<div class="qp-mobile-menu" id="qp-mobile-menu">
  <a href="{{ path('app_home') }}">Home</a>
  <a href="{{ path('app_about') }}">About</a>
  <a href="{{ path('app_contact') }}">Contact</a>
  <div class="qp-mobile-auth">
    <a href="{{ path('app_login') }}" class="qp-mobile-login">Log in</a>
    <a href="{{ path('app_register') }}" class="qp-mobile-signup">Sign up</a>
  </div>
</div>

