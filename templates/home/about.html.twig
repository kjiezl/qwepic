<!-- Join Us CTA -->
<section class="py-20 lg:py-28 bg-gradient-to-br from-space-cadet via-gray-900 to-space-cadet relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute top-1/4 right-1/4 w-80 h-80 bg-vivid-sky-blue/20 rounded-full blur-3xl"></div>
