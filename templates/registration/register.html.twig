{% extends 'base.html.twig' %}

{% block title %}QwePic - Sign Up{% endblock %}

{% block sidebar %}{% endblock %}

{% block main_classes %}{% endblock %}

{% block body %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap');

  :root {
    --qp-red: #42deff;
    --qp-coral: #FF6B6B;
    --qp-dark: #1d1e35;
    --qp-gray: #767676;
    --qp-border: #efefef;
    --qp-light-bg: #f5f5f0;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── Nav ── */
  .qp-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--qp-border);
    padding: 0 1.5rem;
    height: 60px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .qp-nav-logo { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; }
  .qp-nav-logo-img { height: 28px; width: auto; display: block; }
  .qp-nav-links { display: flex; align-items: center; gap: 1.5rem; }
  .qp-nav-link {
    color: #555; text-decoration: none;
    font-family: 'Inter', sans-serif; font-size: 0.95rem; font-weight: 600;
  }
  .qp-nav-link:hover { color: var(--qp-coral); }
  .qp-nav-link.active { color: var(--qp-coral); }
  .qp-btn-outline {
    padding: 0.55rem 1.1rem; border: 2px solid var(--qp-coral); border-radius: 10px;
    color: var(--qp-coral); font-weight: 700; font-size: 0.9rem;
    font-family: 'Inter', sans-serif; text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .qp-btn-outline:hover { background: var(--qp-coral); color: white; }
  .qp-btn-red {
    padding: 0.55rem 1.2rem; border: 2px solid var(--qp-red); background: var(--qp-red);
    border-radius: 10px; color: var(--qp-dark); font-weight: 700; font-size: 0.9rem;
    font-family: 'Inter', sans-serif; text-decoration: none;
    transition: background 0.15s;
  }
  .qp-btn-red:hover { background: #60a5fa; border-color: #60a5fa; }

  .qp-register-wrap {
    min-height: calc(100vh - 70px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    font-family: 'Inter', sans-serif;
    margin-top: 60px;
  }

  /* ── Left panel: photo mosaic ── */
  .qp-login-visual {
    position: relative;
    overflow: hidden;
    background: var(--qp-dark);
  }
  .qp-login-mosaic {
    position: absolute; inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 5px;
    opacity: 0.55;
  }
  .qp-login-mosaic-col {
    display: flex; flex-direction: column; gap: 5px;
  }
  .qp-login-mosaic-col:nth-child(2) { margin-top: -40px; }
  .qp-login-mosaic-col:nth-child(3) { margin-top: 20px; }
  .qp-login-mosaic img {
    width: 100%; object-fit: cover; border-radius: 6px;
  }
  .qp-login-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(29,30,53,0.7) 0%, rgba(29,30,53,0.4) 100%);
  }
  .qp-login-visual-content {
    position: relative; z-index: 2;
    height: 100%;
    display: flex; flex-direction: column;
    justify-content: flex-end;
    padding: 3rem;
  }
  .qp-login-tagline {
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    color: white;
    line-height: 1.2;
    margin-bottom: 1.75rem;
  }
  .qp-login-tagline span { color: var(--qp-coral); }

  /* ── Right panel: form ── */
  .qp-register-form-panel {
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    overflow-y: auto;
  }
  .qp-register-form-inner {
    width: 100%;
    max-width: 400px;
  }
  .qp-login-form-title {
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    font-size: 1.75rem;
    color: var(--qp-dark);
    margin-bottom: 0.85rem;
  }
  .qp-login-form-sub {
    color: var(--qp-gray);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  /* Alerts */
  .qp-alert {
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
    border: 1.5px solid;
  }
  .qp-alert-error { background: #fff0f0; color: #c0392b; border-color: #ffc0c0; }
  .qp-alert-success { background: #f0fff4; color: #1a7a45; border-color: #a3e6c0; }

  /* Fields */
  .qp-field { margin-bottom: 1.2rem; }
  .qp-label {
    display: block;
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--qp-dark);
    margin-bottom: 0.45rem;
  }
  .qp-input-wrap { position: relative; }
  .qp-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1.5px solid #e0e0e0;
    border-radius: 10px;
    font-size: 0.9rem;
    font-family: 'Inter', sans-serif;
    color: var(--qp-dark);
    background: #fafafa;
    outline: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .qp-input:focus { border-color: var(--qp-red); background: white; }
  .qp-input::placeholder { color: #bbb; }
  .qp-input-pw { padding-right: 2.8rem; }

  /* Field error */
  .qp-field-error {
    margin-top: 0.35rem;
    font-size: 0.78rem;
    color: #c0392b;
  }

  /* Password toggle */
  .qp-pw-toggle {
    position: absolute; right: 0.85rem; top: 50%; transform: translateY(-50%);
    background: none; border: none; cursor: pointer; padding: 0;
    color: #aaa; line-height: 1;
    transition: color 0.15s;
  }
  .qp-pw-toggle:hover { color: var(--qp-dark); }

  /* Account type radio group */
  .qp-radio-group {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.15rem;
  }
  .qp-radio-card {
    flex: 1;
    position: relative;
  }
  .qp-radio-card input[type="radio"] {
    position: absolute; opacity: 0; width: 0; height: 0;
  }
  .qp-radio-card label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.65rem 0.5rem;
    border: 1.5px solid #e0e0e0;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--qp-gray);
    cursor: pointer;
    background: #fafafa;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    text-align: center;
  }
  .qp-radio-card input[type="radio"]:checked + label {
    border-color: var(--qp-coral);
    color: var(--qp-coral);
    background: #fff5f5;
  }
  .qp-radio-card label:hover {
    border-color: #ccc;
    color: var(--qp-dark);
  }

  /* Terms checkbox */
  .qp-terms {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.825rem;
    color: var(--qp-gray);
    line-height: 1.5;
  }
  .qp-terms input[type="checkbox"] {
    margin-top: 0.15rem;
    accent-color: var(--qp-coral);
    cursor: pointer;
    flex-shrink: 0;
  }
  .qp-terms a { color: var(--qp-red); text-decoration: none; font-weight: 600; }
  .qp-terms a:hover { text-decoration: underline; }

  /* Submit button */
  .qp-btn-submit {
    width: 100%; padding: 0.85rem;
    background: var(--qp-coral); border: none; border-radius: 10px;
    color: white; font-weight: 700; font-size: 0.95rem;
    font-family: 'Inter', sans-serif; cursor: pointer;
    transition: background 0.15s, transform 0.1s;
  }
  .qp-btn-submit:hover { background: #e05555; }
  .qp-btn-submit:active { transform: scale(0.99); }

  /* Divider */
  .qp-divider {
    display: flex; align-items: center; gap: 0.75rem;
    margin: 1.4rem 0;
    color: #ccc; font-size: 0.8rem;
  }
  .qp-divider::before, .qp-divider::after {
    content: ''; flex: 1; height: 1px; background: #eee;
  }

  /* Google button */
  .qp-btn-google {
    display: flex; align-items: center; justify-content: center; gap: 0.6rem;
    width: 100%; padding: 0.75rem;
    border: 1.5px solid #e0e0e0; border-radius: 10px;
    color: var(--qp-dark); font-size: 0.9rem; font-weight: 600;
    font-family: 'Inter', sans-serif; text-decoration: none;
    background: white;
    transition: background 0.15s, border-color 0.15s;
  }
  .qp-btn-google:hover { background: #fafafa; border-color: #ccc; }

  /* Login link */
  .qp-login-switch {
    text-align: center;
    margin-top: 1.2rem;
    font-size: 0.875rem;
    color: var(--qp-gray);
  }
  .qp-login-switch a {
    color: var(--qp-red); font-weight: 700; text-decoration: none;
  }
  .qp-login-switch a:hover { text-decoration: underline; }

  /* Mobile */
  @media (max-width: 768px) {
    .qp-register-wrap { grid-template-columns: 1fr; }
    .qp-login-visual { display: none; }
    .qp-register-form-panel { padding: 2.5rem 1.25rem; align-items: flex-start; padding-top: 3rem; }
    .qp-nav-links { display: none; }
  }
</style>

<nav class="qp-nav">
  <a href="{{ path('app_home') }}" class="qp-nav-logo">
    <img src="{{ asset('images/logo-plain.svg') }}" alt="QwePic" class="qp-nav-logo-img">
  </a>
  <div class="qp-nav-links">
    <a href="{{ path('app_home') }}" class="qp-nav-link">Home</a>
    <a href="{{ path('app_about') }}" class="qp-nav-link">About</a>
    <a href="{{ path('app_contact') }}" class="qp-nav-link">Contact</a>
  </div>
  <div style="display:flex;align-items:center;gap:0.6rem;">
    <a href="{{ path('app_login') }}" class="qp-btn-outline">Log in</a>
    <a href="{{ path('app_register') }}" class="qp-btn-red">Sign up</a>
  </div>
</nav>

<div class="qp-register-wrap">

  <!-- ── Left: photo mosaic ── -->
  <div class="qp-login-visual">
    <div class="qp-login-mosaic">
      <div class="qp-login-mosaic-col">
        <img src="https://images.unsplash.com/photo-1542038784456-1ea8e935640e?w=300&q=70" style="height:260px;" alt="">
        <img src="https://images.unsplash.com/photo-1471341971476-ae15ff5dd4ea?w=300&q=70" style="height:220px;" alt="">
        <img src="https://images.unsplash.com/photo-1554048612-b6a482bc67e5?w=300&q=70" style="height:200px;" alt="">
      </div>
      <div class="qp-login-mosaic-col">
        <img src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=300&q=70" style="height:240px;" alt="">
        <img src="https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?w=300&q=70" style="height:260px;" alt="">
        <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=300&q=70" style="height:180px;" alt="">
      </div>
      <div class="qp-login-mosaic-col">
        <img src="https://images.unsplash.com/photo-1519741497674-611481863552?w=300&q=70" style="height:280px;" alt="">
        <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=300&q=70" style="height:200px;" alt="">
        <img src="https://images.unsplash.com/photo-1775664352285-321b99a86ab8?w=300&q=70" style="height:240px;" alt="">
      </div>
    </div>
    <div class="qp-login-overlay"></div>
    <div class="qp-login-visual-content">
      <h2 class="qp-login-tagline">Join a community of<br><span>talented photographers</span></h2>
    </div>
  </div>

  <!-- ── Right: form panel ── -->
  <div class="qp-register-form-panel">
    <div class="qp-register-form-inner">

      <h1 class="qp-login-form-title">Create your account</h1>

      {% for message in app.flashes('error') %}
        <div class="qp-alert qp-alert-error">{{ message }}</div>
      {% endfor %}

      {{ form_start(registrationForm) }}

        <div class="qp-field">
          {{ form_label(registrationForm.username, null, {'label_attr': {'class': 'qp-label'}}) }}
          {{ form_widget(registrationForm.username, {'attr': {'class': 'qp-input', 'placeholder': 'Choose a username'}}) }}
          {% set fieldErrors = form_errors(registrationForm.username) %}
          {% if fieldErrors is not empty %}
            <div class="qp-field-error">{{ fieldErrors|striptags }}</div>
          {% endif %}
        </div>

        <div class="qp-field">
          {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'qp-label'}}) }}
          {{ form_widget(registrationForm.email, {'attr': {'class': 'qp-input', 'placeholder': 'you@example.com'}}) }}
          {% set fieldErrors = form_errors(registrationForm.email) %}
          {% if fieldErrors is not empty %}
            <div class="qp-field-error">{{ fieldErrors|striptags }}</div>
          {% endif %}
        </div>

        <div class="qp-field">
          {{ form_label(registrationForm.accountType, null, {'label_attr': {'class': 'qp-label'}}) }}
          <div class="qp-radio-group">
            {% for choice in registrationForm.accountType %}
              <div class="qp-radio-card">
                {{ form_widget(choice) }}
                <label for="{{ choice.vars.id }}">{{ choice.vars.label }}</label>
              </div>
            {% endfor %}
          </div>
          {% set fieldErrors = form_errors(registrationForm.accountType) %}
          {% if fieldErrors is not empty %}
            <div class="qp-field-error">{{ fieldErrors|striptags }}</div>
          {% endif %}
        </div>

        <div class="qp-field">
          {{ form_label(registrationForm.plainPassword, 'Password', {'label_attr': {'class': 'qp-label'}}) }}
          <div class="qp-input-wrap">
            {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'qp-input qp-input-pw', 'id': 'inputRegPassword', 'placeholder': 'Create a password'}}) }}
            <button type="button" class="qp-pw-toggle" onclick="toggleRegPassword()" aria-label="Toggle password">
              <svg id="reg-eye-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
          {% set fieldErrors = form_errors(registrationForm.plainPassword) %}
          {% if fieldErrors is not empty %}
            <div class="qp-field-error">{{ fieldErrors|striptags }}</div>
          {% endif %}
        </div>

        <div class="qp-terms">
          {{ form_widget(registrationForm.agreeTerms) }}
          {{ form_label(registrationForm.agreeTerms) }}
        </div>
        {% set fieldErrors = form_errors(registrationForm.agreeTerms) %}
        {% if fieldErrors is not empty %}
          <div class="qp-field-error" style="margin-top:-1rem;margin-bottom:1rem;">{{ fieldErrors|striptags }}</div>
        {% endif %}

        <button type="submit" class="qp-btn-submit">Create Account</button>

      {{ form_end(registrationForm) }}
      
      <div class="qp-divider">or</div>

      <a href="{{ path('connect_google') }}" class="qp-btn-google">
        <svg width="18" height="18" viewBox="0 0 18 18">
          <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
          <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
          <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
          <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 6.29C4.672 4.163 6.656 3.58 9 3.58z"/>
        </svg>
        Continue with Google
      </a>

      <div class="qp-login-switch">
        Already have an account? <a href="{{ path('app_login') }}">Log in</a>
      </div>

    </div>
  </div>

</div>

<script>
  function toggleRegPassword() {
    const input = document.getElementById('inputRegPassword');
    const icon = document.getElementById('reg-eye-icon');
    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    icon.innerHTML = isPassword
      ? `<path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>`
      : `<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>`;
  }
</script>

{% endblock %}
