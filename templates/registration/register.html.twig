{% extends 'base.html.twig' %}

{% block title %}QwePic - Sign Up{% endblock %}

{% block main_classes %}min-h-screen{% endblock %}

{% block body %}
<div class="min-h-screen bg-anti-flash-white flex items-center justify-center p-8 font-sans">
    <div class="bg-white rounded-2xl shadow-elevated w-full max-w-md overflow-hidden">
        <!-- QwePic Logo -->
        <div class="text-center p-8 bg-gradient-to-br from-gray-50 to-gray-100">
            <img src="{{ asset('images/logo-plain.svg') }}" alt="QwePic Logo" class="w-32 h-auto mx-auto">
        </div>

        <!-- Sign Up Form -->
        <div class="p-8">
            <h1 class="font-heading font-bold text-3xl text-space-cadet text-center mb-4">Sign Up</h1>

            <div class="text-center mb-8">
                <p class="text-slate-gray text-sm leading-relaxed">Join our community and start capturing memories.</p>
            </div>

            {% for message in app.flashes('error') %}
                <div class="p-4 rounded-lg mb-4 bg-red-50 text-red-700 border border-red-200">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="social-login">
                    <div class="flex justify-center">
                        <a href="{{ path('connect_google') }}" class="btn-google flex items-center justify-center p-3 border border-gray-300 rounded-lg text-sm text-space-cadet hover:bg-gray-100">
                            <svg width="18" height="18" viewBox="0 0 18 18">
                                <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
                                <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
                                <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
                                <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 6.29C4.672 4.163 6.656 3.58 9 3.58z"/>
                            </svg>
                            <span class="ml-2">Continue with Google</span>
                        </a>
                    </div>
                <div class="divider flex justify-center items-center my-4"><span>or</span></div>
            </div>

            {{ form_start(registrationForm, {'attr': {'class': 'w-full'}}) }}
                <div class="mb-6">
                    {{ form_label(registrationForm.username, null, {
                        'label_attr': {
                            'class': 'block text-sm font-medium text-space-cadet mb-1'
                        }
                    }) }}
                    {{ form_widget(registrationForm.username, {
                        'attr': {
                            'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-space-cadet placeholder-slate-gray bg-anti-flash-white focus:outline-none focus:ring-2 focus:ring-vivid-sky-blue focus:border-vivid-sky-blue'
                        }
                    }) }}
                    {% set fieldErrors = form_errors(registrationForm.username) %}
                    {% if fieldErrors is not empty %}
                        <div class="mt-1 text-xs text-accent-coral">
                            {{ fieldErrors|striptags }}
                        </div>
                    {% endif %}
                </div>
                <div class="mb-6">
                    {{ form_label(registrationForm.email, null, {
                        'label_attr': {
                            'class': 'block text-sm font-medium text-space-cadet mb-1'
                        }
                    }) }}
                    {{ form_widget(registrationForm.email, {
                        'attr': {
                            'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-space-cadet placeholder-slate-gray bg-anti-flash-white focus:outline-none focus:ring-2 focus:ring-vivid-sky-blue focus:border-vivid-sky-blue'
                        }
                    }) }}
                    {% set fieldErrors = form_errors(registrationForm.email) %}
                    {% if fieldErrors is not empty %}
                        <div class="mt-1 text-xs text-accent-coral">
                            {{ fieldErrors|striptags }}
                        </div>
                    {% endif %}
                </div>
                <div class="mb-6">
                    {{ form_label(registrationForm.accountType, null, {
                        'label_attr': {
                            'class': 'block text-sm font-medium text-space-cadet mb-1'
                        }
                    }) }}
                    <div class="space-y-2">
                        {% for choice in registrationForm.accountType %}
                            <label class="flex items-center text-sm text-slate-gray cursor-pointer">
                                {{ form_widget(choice, {
                                    'attr': {
                                        'class': 'w-4 h-4 accent-accent-coral cursor-pointer'
                                    }
                                }) }}
                                <span class="ml-2">{{ choice.vars.label }}</span>
                            </label>
                        {% endfor %}
                    </div>
                    {% set fieldErrors = form_errors(registrationForm.accountType) %}
                    {% if fieldErrors is not empty %}
                        <div class="mt-1 text-xs text-accent-coral">
                            {{ fieldErrors|striptags }}
                        </div>
                    {% endif %}
                </div>
                <div class="mb-6">
                    {{ form_label(registrationForm.plainPassword, 'Password', {
                        'label_attr': {
                            'class': 'block text-sm font-medium text-space-cadet mb-1'
                        }
                    }) }}
                    {{ form_widget(registrationForm.plainPassword, {
                        'attr': {
                            'class': 'w-full px-3 py-2 border border-gray-300 rounded-lg text-sm text-space-cadet placeholder-slate-gray bg-anti-flash-white focus:outline-none focus:ring-2 focus:ring-vivid-sky-blue focus:border-vivid-sky-blue'
                        }
                    }) }}
                    {% set fieldErrors = form_errors(registrationForm.plainPassword) %}
                    {% if fieldErrors is not empty %}
                        <div class="mt-1 text-xs text-accent-coral">
                            {{ fieldErrors|striptags }}
                        </div>
                    {% endif %}
                </div>
                <div class="mb-6">
                    <div class="flex items-start">
                        {{ form_widget(registrationForm.agreeTerms, {
                            'attr': {
                                'class': 'w-4 h-4 mt-0.5 accent-accent-coral cursor-pointer'
                            }
                        }) }}
                        {{ form_label(registrationForm.agreeTerms, null, {
                            'label_attr': {
                                'class': 'ml-2 text-sm text-slate-gray cursor-pointer'
                            }
                        }) }}
                    </div>
                    {% set fieldErrors = form_errors(registrationForm.agreeTerms) %}
                    {% if fieldErrors is not empty %}
                        <div class="mt-1 text-xs text-accent-coral">
                            {{ fieldErrors|striptags }}
                        </div>
                    {% endif %}
                </div>
                <button type="submit"
                        class="w-full p-4 bg-accent-coral text-anti-flash-white font-semibold text-base rounded-lg cursor-pointer transition duration-300 hover:bg-red-400 mb-6 font-sans">
                    Sign Up
                </button>
            {{ form_end(registrationForm) }}

            <!-- Switch to Login -->
            <div class="text-center pt-6 border-t border-gray-200">
                <p class="text-slate-gray text-sm">
                    Already a member?
                    <a href="{{ path('app_login') }}" class="text-vivid-sky-blue font-semibold transition duration-300 hover:text-blue-400">Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}